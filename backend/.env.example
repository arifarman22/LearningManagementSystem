# Server
HOST=0.0.0.0
PORT=1337

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
APP_KEYS=toBeModified1,toBeModified2,toBeModified3,toBeModified4
API_TOKEN_SALT=toBeModified
ADMIN_JWT_SECRET=toBeModified
JWT_SECRET=toBeModified
TRANSFER_TOKEN_SALT=toBeModified
ENCRYPTION_KEY=toBeModified

# JWT config
JWT_EXPIRES_IN=7d

# Database — local development (individual fields)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=lms_dev
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=yourpassword
DATABASE_SSL=false

# Database — production (Railway provides DATABASE_URL automatically)
# When DATABASE_URL is set it takes priority over individual fields above
DATABASE_URL=postgresql://user:password@host:port/dbname

# CORS — comma-separated list of allowed frontend origins
# Development: http://localhost:3000
# Production:  https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
