# ─────────────────────────────────────────────────────────────────────────────
# LMS Frontend — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── API URLs ──────────────────────────────────────────────────────────────────
# Full URL to the Strapi API (include /api suffix)
# Local:      http://localhost:1337/api
# Production: https://your-backend.up.railway.app/api
NEXT_PUBLIC_API_URL=http://localhost:1337/api

# Base URL of the Strapi server (no /api suffix) — used for media/uploads
# Local:      http://localhost:1337
# Production: https://your-backend.up.railway.app
NEXT_PUBLIC_STRAPI_URL=http://localhost:1337
